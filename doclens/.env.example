# Web/MCP 监听地址与端口（改后需重启 gui 才生效）
CORTEX_WEB_HOST=0.0.0.0
CORTEX_WEB_PORT=7860
CORTEX_MCP_HOST=127.0.0.1
CORTEX_MCP_PORT=7880
# 访问密码哈希（设置页设置密码时自动写入；留空=未设密码）
CORTEX_WEB_PASSWORD_HASH=

# AI 对话（LLM）模型 —— 可在设置页「模型预设」一键切换；以下为字段散填/微调入口
CORTEX_ACTIVE_LLM_PRESET=
PLANIFY_PROTOCOL=openai_compat
PLANIFY_BASE_URL=
PLANIFY_MODEL_ID=
PLANIFY_API_KEY=
PLANIFY_CONTEXT_WINDOW=

# 视觉模型（图像文件解析索引，独立于上面的 AI 对话配置）
# 协议由 VISION_PROTOCOL 控制：留空=OpenAI-compat；anthropic=Anthropic /v1/messages
# 未配置 VISION_API_KEY 时：图像文件只进占位节点（文件名可搜索），不做视觉解析。
# 配置后由后台 VisionWorker 串行解析，不拖慢主索引。
CORTEX_ACTIVE_VISION_PRESET=
VISION_PROTOCOL=
VISION_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
VISION_MODEL=qwen-vl-max
VISION_API_KEY=
# 例如用 minimax coding plan 的 /anthropic + MiniMax-M3 做图像分析：
#   VISION_PROTOCOL=anthropic
#   VISION_BASE_URL=https://api.minimaxi.com/anthropic
#   VISION_MODEL=MiniMax-M3

# 百度天气 API（planify 工具，供日记天气查询；默认已指向百度官方 v1 端点）
# 需在百度地图开放平台申请 AK；未配 AK 则天气查询失败（降级为不带天气，不阻断日记）
BAIDU_WEATHER_API_URL=https://api.map.baidu.com/weather/v1/
BAIDU_WEATHER_AK=
BAIDU_WEATHER_DATA_TYPE=fc

# search tool 返回的最多的结果数(包含不同文档)
CORTEX_MAX_RESULTS=50

# 关键词集中度窗口（字符数），超过则不算紧邻
CORTEX_MAX_SPAN=50

# 综合评分阈值（低于此值的搜索结果将被过滤）
# 0.0 = 不过滤（LLM 需要多个候选做综合推理）
# 0.3 = 默认，轻度过滤（去掉低分结果）
# 0.7+ = 严格过滤（容易把多关键词 query 的有效结果砍光，慎用）
CORTEX_MIN_SCORE_THRESHOLD=0.5

# 关键词匹配权重
CORTEX_WEIGHT_KEYWORD_MATCH=4.0

# 文件名匹配权重
CORTEX_WEIGHT_FILE_NAME_MATCH=2.0

# FTS 原始分数权重（sigmoid 归一化后区分度较低，权重不宜过高）
CORTEX_WEIGHT_FTS_SCORE=1.0

# 标题匹配权重
CORTEX_WEIGHT_TITLE_MATCH=2.0

# 邻近度权重（0=无匹配, 1=部分匹配, 2=全部关键词紧邻，归一化为 0/0.5/1.0）
CORTEX_WEIGHT_PROXIMITY_MATCH=1.0
