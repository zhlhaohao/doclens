# ============================================================
# Web / MCP 监听（host/port/开关改后需重启 gui 才生效）
# ============================================================
CORTEX_WEB_HOST=127.0.0.1
CORTEX_WEB_PORT=7860
CORTEX_MCP_ENABLED=false
CORTEX_MCP_HOST=127.0.0.1
CORTEX_MCP_PORT=7880
# MCP bearer 认证 token：MCP 绑定非环回地址（0.0.0.0 等）时必须设置，留空 = 无认证
CORTEX_MCP_TOKEN=

# 访问密码哈希（设置页设置密码时自动写入；留空=未设密码）
CORTEX_WEB_PASSWORD_HASH=

# ============================================================
# 日志
# ============================================================
# 文件日志级别：INFO（默认）/ DEBUG（全量，排障时临时开）/ WARNING / ERROR / CRITICAL。
# 改后需重启。非法值回落 INFO。
CORTEX_LOG_LEVEL=INFO
# 日志目录（默认 {工作目录}/<数据目录>/logs）。移出被监控的知识库目录可
# 让日志写入完全不产生文件事件（运维项，一般无需配置）。
# CORTEX_LOG_DIR=

# ============================================================
# AI 对话（LLM）模型
# ============================================================
CORTEX_ACTIVE_LLM_PRESET=
PLANIFY_PROTOCOL=
PLANIFY_BASE_URL=
PLANIFY_MODEL_ID=
PLANIFY_API_KEY=
# LLM 上下文窗口（tokens）。自动压缩阈值 = 该值 × 0.8
PLANIFY_CONTEXT_WINDOW=200000
# LLM 单次响应最大输出 tokens（默认 8000）。主代理与子代理共用；
# 子代理并发拆分读取时，每组读取量上限 = 该值 × 0.8（词数，为摘要输出留余量）。
# 模型支持更长输出（如 32k/64k）时建议调大，否则子代理摘要易被截断、章节缺失。
PLANIFY_MAX_TOKENS=8000
# 单轮问答工具调用轮数软上限：超过后每轮注入停止提醒；硬阈值 = 该值 + 10，
# 达到后强制终答；0 = 不限（默认——不设上限，仅保留同参死循环提醒）。
PLANIFY_MAX_TOOL_ROUNDS=0

# shell 工具超时（秒，默认 120）：bash/powershell 前台命令的最长等待。
# 长命令的正道是 background_run 后台启动 + check_background 轮询，而非调大本值硬等。
PLANIFY_SHELL_TIMEOUT=120

# LLM 追踪落盘（调试/计算缓存命中率）：1 开启后每次 LLM 调用的实发请求体
# （含 cache_control 断点）与实收原生响应（含 usage）原样追加到
# {工作目录}/.planify/llm_trace/<日期>-<会话id>.md——每聊天会话一文件、
# 轮次号跨输入连续；文本不压缩，图像 base64 换占位符；目录已被 GitSync
# 自动 gitignore，不随知识库同步。0 = 关闭（默认）。改后需重启。
# 输出目录可用 PLANIFY_LLM_TRACE_DIR 覆盖（默认 {工作目录}/.planify/llm_trace/）。
PLANIFY_LLM_TRACE=0

# 工具白名单（不设置 = 全部注册）。注意：GUI 模式下 ask_user_question 是唯一的
# 用户交互通道（旧 ask_user/user_confirm 在 GUI 被过滤），即使白名单漏列也会强制保留。
# PLANIFY_ENABLED_TOOLS=bash,powershell,read_file,write_file,edit_file,TodoWrite,task,load_skill,task_create,task_get,task_update,task_list,claim_task,spawn_teammate,list_teammates,send_message,read_inbox,broadcast,shutdown_request,plan_approval,idle,background_run,check_background,compress,ask_user,user_confirm,ask_user_question,baidu_weather,webfetch,search_kb,manage_kb,read_document,file_info,grep

# 外部访问门禁（ADR-0021，仅 GUI 链路生效）：AI 工具读写「工作目录以外」路径时的处置。
# ask   （默认）弹安全确认卡片，确认后本会话内按目录授权（读/写分账，会话结束失效）
# allow 不问直接放行（关闭确认，bash 行为回到旧版）
# block 不问直接拦截（严格模式）
# 覆盖 read_file/write_file/edit_file（精确路径判定）与 bash/powershell/background_run
# （命令文本绝对路径扫描——纵深防御而非沙箱，变量拼接等写法可绕过属已知局限）。
# 子代理/后台线程无交互渠道：未授权一律按 block 处理（fail-closed）。
# PLANIFY_OUTSIDE_WORKDIR=ask

# SSE 断开续跑（ADR-0028）：true = 消费端断开（关页面/断网）不终止生成，
# 重连可续看；主动停止仍立停。false = 恢复旧行为（断开即终止）。
CORTEX_CHAT_DISCONNECT_CONTINUE=true

# 工作目录配置（次优先级，仅在未显式传 -C 时生效）：进程启动时切换到该目录
# （索引/.env/日志/门禁基准全部跟随）。读取顺序：环境变量 > 启动目录
# <数据目录>/.env > 全局 ~/.cortex/.env；只跳转一次。
# 留空 = 按启动目录。改后需重启；目录不存在会启动失败。
# CORTEX_WORKDIR=

# ============================================================
# 视觉模型（图像文件解析索引，独立于上面的 AI 对话配置）
# ============================================================
CORTEX_ACTIVE_VISION_PRESET=
# 协议：留空 = OpenAI-compat（/chat/completions + image_url，默认）；
# anthropic = Anthropic 格式（/v1/messages + image source，如 minimax /anthropic + M3）
VISION_PROTOCOL=
VISION_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
VISION_MODEL=qwen-vl-max
VISION_API_KEY=
# 上传图片（文件管理/日记）后台视觉判向自动转正（默认关闭）：每张上传
# 图片消耗一次视觉 API 调用，需显式 opt-in；且要求已配置 VISION_API_KEY。
VISION_AUTO_ROTATE=false

# ============================================================
# 百度天气 API（planify 工具，供日记天气查询；默认已指向百度官方 v1 端点）
# ============================================================
BAIDU_WEATHER_API_URL=https://api.map.baidu.com/weather/v1/
BAIDU_WEATHER_DATA_TYPE=fc
BAIDU_WEATHER_AK=

# ============================================================
# 搜索（search / grep / read_document）
# ============================================================
CORTEX_ACTIVE_SEARCH_PRESET=
# search tool 返回的最多的结果数(包含不同文档)
CORTEX_MAX_RESULTS=50
# read_document 单次输出词数预算（词：汉字每字一词，英文按空白切分；
# 超出预算截断并提示 AI 用 file_info/start_word/end_word 续读。影响 LLM token 消耗）
CORTEX_MAX_READ_WORDS=4000
# read_document 是否输出目录结构（默认关闭以节省 token）
CORTEX_READ_DOC_SHOW_TOC=false
# 关键词集中度窗口（字符数），超过则不算紧邻
CORTEX_MAX_SPAN=50
# 综合评分阈值（低于此值的搜索结果将被过滤）
CORTEX_MIN_SCORE_THRESHOLD=0.3
# 搜索结果片段统一窗口：锚点前/后词数（词：CJK 每字一词，其余按空白切分；
# grep 与 search 同口径；grep 正则自声明跨度时保留跨度语义，另加前后窗口）
CORTEX_SEARCH_CONTEXT_BEFORE=200
CORTEX_SEARCH_CONTEXT_AFTER=600
# grep 返回的最多的结果数（默认 50）
CORTEX_GREP_MAX_RESULTS=50
# grep 结果分数下限（默认 0 = 不过滤）
CORTEX_GREP_SCORE_THRESHOLD=0.0
# grep 匹配体硬上限：防贪婪正则（如 [\s\S]*）把整个文档灌进单条结果。
# 高级项，一般无需调整。
CORTEX_GREP_MATCH_MAX_CHARS=2000
# 参与评分的候选文档数上限 / 单文档索引节点数上限
CORTEX_TOP_K_DOCS=100
CORTEX_MAX_NODES_PER_DOC=1000

# KB 工具字符预算（影响 LLM token 消耗）：单条结果上下文上限 / 结果总上下文上限
CORTEX_MAX_CONTEXT_CHARS_PER_RESULT=800
CORTEX_MAX_TOTAL_CHARS=10000

# 评分权重
CORTEX_WEIGHT_KEYWORD_MATCH=4.0
CORTEX_WEIGHT_FILE_NAME_MATCH=2.0
CORTEX_WEIGHT_FTS_SCORE=1.0
CORTEX_WEIGHT_TITLE_MATCH=2.0
CORTEX_WEIGHT_PROXIMITY_MATCH=1.0

# ripgrep 降级搜索上下文（FTS 无结果时走 rg：匹配行前/后行数）
CORTEX_RG_CONTEXT_BEFORE=6
CORTEX_RG_CONTEXT_AFTER=5

# ============================================================
# 索引 / 文件监控 / Git 同步
# ============================================================
# 文件监控（watcher）：开关与防抖秒数
CORTEX_WATCH_ENABLED=true
CORTEX_WATCH_DEBOUNCE=5.0
# 知识库 Git 自动同步（默认关闭）：开启后每轮自动 commit → pull →
# merge(偏向本地) → push，并自动写 .gitignore/.gitattributes。属侵入性
# 操作，需显式 opt-in；仅 GUI 进程运行，且要求工作目录是 git 根 + 有 remote。
CORTEX_SYNC_ENABLED=false
CORTEX_SYNC_INTERVAL_MINUTES=5.0
# 连续解析失败 N 次后跳过该文件（默认 3）
CORTEX_MAX_INDEX_FAIL_COUNT=3
# 中日韩分词器：jieba（默认）/ bigram / char / auto
# 注意：doclens 链路读 CORTEX_ 前缀（treesearch 原生 TREESEARCH_CJK_TOKENIZER
# 在 doclens 内不生效——索引配置由宿主统一注入）
CORTEX_CJK_TOKENIZER=jieba
# 允许索引的文件类型（逗号分隔，留空 = 全部允许）
CORTEX_ALLOWED_SOURCE_TYPES=markdown,text,csv,pdf,doc,docx,rtf,pptx,ppt,excel,html,image,pst,epub
# 二进制文件影子 Markdown（PDF/DOCX 等生成隐藏 .md 副本供 rg 降级搜索）：
# doclens 默认关闭（提速索引）；treesearch 独立 CLI 的原生默认为开启
TREESEARCH_ENABLE_SHADOW_MD=false
# 单目录遍历文件数上限（0=不设限，默认）。防误扫巨型目录可设为正整数
# （如 10000）；企业级语料保持 0 即可。
TREESEARCH_MAX_DIR_FILES=0
# 分块索引块大小（文件数，默认 500）。每块「解析→落库→释放」循环推进，
# 百万级语料内存峰值 = 单块，不再 OOM（ADR-0018）。
# ⚠️ 0 = 不分块（旧行为全量攒内存）——与上面 MAX_DIR_FILES 的 0=不设限有意相反！
TREESEARCH_INDEX_CHUNK_SIZE=500
# Excel 解析上限：每 sheet 最多索引行数 / 连续空行容忍数（超出即停）
TREESEARCH_XLSX_MAX_ROWS_PER_SHEET=10000
TREESEARCH_XLSX_MAX_CONSECUTIVE_EMPTY_ROWS=100
# PST 邮件解析 sidecar（pst-extract）可执行文件路径覆盖：
# 留空 = 自动用包内 _bin/ 目录（一般无需配置）
# TREESEARCH_PST_EXTRACT=

# ============================================================
# TUI 终端显示（仅命令行/TUI 模式，GUI 不受影响）
# ============================================================
CORTEX_TITLE_WIDTH=55
CORTEX_LINE_WIDTH=78
CORTEX_MAX_CONTEXT_LINES=5
CORTEX_MAX_ANCHOR_LINES=3
CORTEX_CONTEXT_EXPAND_RANGE=5
CORTEX_MIN_KEYWORDS_PER_LINE=2
